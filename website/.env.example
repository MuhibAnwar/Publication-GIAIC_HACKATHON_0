# Environment Variables for Physical AI & Humanoid Robotics Textbook

# API endpoints for assessment and progress tracking
REACT_APP_API_BASE_URL=https://api.physical-ai-textbook.com/v1

# For LTI integration
REACT_APP_LTI_CONSUMER_KEY=your_lti_consumer_key
REACT_APP_LTI_CONSUMER_SECRET=your_lti_consumer_secret

# Analytics (if needed)
REACT_APP_GA_TRACKING_ID=your_ga_tracking_id

# Search configuration (if using Algolia instead of local search)
REACT_APP_ALGOLIA_APP_ID=your_algolia_app_id
REACT_APP_ALGOLIA_SEARCH_KEY=your_algolia_search_key
REACT_APP_ALGOLIA_INDEX_NAME=your_algolia_index_name